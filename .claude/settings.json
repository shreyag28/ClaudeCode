{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          
          {
            "type": "command",
            "if": "Bash(git reset --hard*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-destructive-git.sh",
            "args": ["reset"]
          },
          
          {
            "type": "command",
            "if": "Bash(git clean -fd*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-destructive-git.sh",
            "args": ["clean"]
          },

          {
            "type": "command",
            "if": "Bash(git push --force*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/require-approval.sh",
            "args": ["force-push"]
          },

          {
            "type": "command",
            "if": "Bash(git push *--force*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/require-approval.sh",
            "args": ["force-push-variant"]
          }

        ]
      }
    ]
  }
}
